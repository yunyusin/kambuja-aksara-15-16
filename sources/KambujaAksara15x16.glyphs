sub uni17C2.ra by k.17D2_179A.l1.b uni17C2;
sub uni17C3.ra by k.17D2_179A.l1.b uni17C3;


# ----- cluster for ri, rii, li, lii
lookup format_rili;


# ----- vannayutti work
lookup rewrite_bind_vannayutti;
lookup rewrite_release_vannayutti;

";
